NEXT_PUBLIC_SITE_URL=https://your-devfoliox-domain.example
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional server-only token for a higher GitHub API rate limit during public-repo import.
# Public imports work without it, but unauthenticated GitHub API requests are more limited.
GITHUB_TOKEN=

# Optional. Resume import reads the uploaded PDF/DOCX with Gemini when this is
# set, which handles two-column layouts the text parser cannot recover once the
# PDF is flattened. Without it, import falls back to the built-in parser, and it
# also falls back whenever the call fails. Server-only: never prefix with
# NEXT_PUBLIC_. Note that resumes contain personal data, so enabling this sends
# that text to Google.
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Grants access to /admin/analytics. Server-only: never prefix with NEXT_PUBLIC_.
# Must also be set on the Edge Function: supabase secrets set ADMIN_EMAIL=you@example.com
ADMIN_EMAIL=

# Auth emails are sent by the send-email Edge Function over Brevo's HTTP API.
# These live as Supabase project secrets, not in the app environment:
#   supabase secrets set BREVO_API_KEY=... BREVO_SENDER_EMAIL=... \
#     BREVO_SENDER_NAME=... SEND_EMAIL_HOOK_SECRET=...
# They are listed here only so the set is discoverable.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
SEND_EMAIL_HOOK_SECRET=
